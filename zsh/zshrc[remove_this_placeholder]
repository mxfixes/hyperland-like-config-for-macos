# Map pacman commands to brew equivalents on macOS
pacman() {
  case "$1" in
    -S|--sync)
      shift
      brew install "$@"
      ;;
    -Syu|-Sy)
      brew update && brew upgrade
      if [ $# -gt 1 ]; then
        shift
        brew install "$@"
      fi
      ;;
    -R|-Rs|--remove)
      shift
      brew uninstall "$@"
      ;;
    -Ss|--search)
      shift
      brew search "$@"
      ;;
    -Si|-Qi|--info)
      shift
      brew info "$@"
      ;;
    -Qe|--list)
      brew list
      ;;
    -Sc|-Scc)
      brew cleanup
      ;;
    *)
      brew "$@"
      ;;
  esac
}
